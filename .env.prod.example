# Copy to .env on the server, next to compose.prod.yaml. Never commit it.
# Public name of the kiosk. Its DNS record must point at this server (ports 80 and 443 open).
DOMAIN=kiosk.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Use letters, digits, - and _ only (it goes inside a URL).
POSTGRES_PASSWORD=
POSTGRES_USER=kiosk
POSTGRES_DB=kiosk
# The lab's time zone, for display and day/month boundaries (ADR 0016).
TIME_ZONE=UTC
