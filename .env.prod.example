# Copy to .env on the server, next to compose.prod.yaml. Never commit it.
# Public name of the kiosk. Its DNS record must point at this server (ports 80 and 443 open).
DOMAIN=kiosk.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Rotating SECRET_KEY: put the old one here (comma-separated) for a week, then remove it.
SECRET_KEY_FALLBACKS=
# Use letters, digits, - and _ only (it goes inside a URL).
POSTGRES_PASSWORD=
POSTGRES_USER=kiosk
POSTGRES_DB=kiosk
# The lab's time zone, for display and day/month boundaries (ADR 0016).
TIME_ZONE=UTC
# Backups (ADR 0034). Public key from `age-keygen` run on YOUR computer, never on this server.
BACKUP_AGE_RECIPIENT=
# Optional off-site copy with rclone, for example b2:my-bucket/kiosk. Strongly recommended.
BACKUP_RCLONE_REMOTE=
